FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# PostgreSQL: On macOS (Homebrew), use your system username (role "postgres" doesn't exist by default)
# DATABASE_URL=postgresql://YOUR_USERNAME@localhost:5432/iris_db
# Or with password: postgresql://username:password@localhost:5432/iris_db
# Or use SQLite (no setup): unset DATABASE_URL or leave commented
DATABASE_URL=postgresql://postgres:password@localhost:5432/iris_db

UPLOAD_FOLDER=uploads
REPORTS_FOLDER=reports
MAX_CONTENT_LENGTH=5242880

CORS_ORIGINS=http://localhost:5173

# Ollama LLM for report generation (optional - reports work without it)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=meditron:7b
OLLAMA_TIMEOUT=120
